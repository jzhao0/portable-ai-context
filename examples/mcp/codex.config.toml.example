# Inert example only. Review and copy into your own Codex config if desired.
# Replace the generic placeholder with the workspace PAIC is allowed to inspect.

[mcp_servers.paic]
command = "paic"
args = ["mcp", "--root", "/ABSOLUTE/PATH/TO/WORKSPACE"]
enabled_tools = ["inspect_source", "conform_source", "build_checkpoint", "build_redaction_review"]
default_tools_approval_mode = "prompt"
